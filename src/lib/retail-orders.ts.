/**
 * retail-orders.ts
 * ─────────────────────────────────────────────────────────────────────────────
 * Single source of truth for the ClarityFlow retail ordering engine.
 *
 * Everything here is PURE — no Firestore, no React, no side effects — so it is
 * safe to import from API routes, server components, and 'use client' files.
 *
 * Firestore layout (tenant-scoped):
 *   tenants/{tenantId}/products/{productId}
 *   tenants/{tenantId}/retailOrders/{orderId}
 *   tenants/{tenantId}/retailOrders/{orderId}/events/{eventId}      (append-only)
 *   tenants/{tenantId}/fulfillmentBatches/{batchId}
 *   tenants/{tenantId}/inventoryLedger/{entryId}                     (append-only)
 *   tenants/{tenantId}/retailReturns/{returnId}
 */

/* ════════════════════════════════════════════════════════════════════════════
 * STAGES & TRANSITIONS
 * ════════════════════════════════════════════════════════════════════════════ */

export const ORDER_STAGES = [
  'placed',      // checkout created, awaiting payment confirmation
  'paid',        // Stripe webhook confirmed; stock reserved; in queue
  'picking',     // claimed in a batch; items being scanned
  'packed',      // every line fully scanned or explicitly shorted
  'ready',       // pickup orders: on the ready shelf / label printed for ship
  'arrived',     // curbside only: customer checked in "I'm here"
  'shipped',     // ship orders: carrier label scanned onto box
  'handed_off',  // pickup: customer QR scanned at counter/car
  'completed',   // terminal success
  'cancelled',   // terminal: refunded, reservations released
  'refunded',    // terminal: post-completion full refund (via return flow)
] as const;

export type OrderStage = (typeof ORDER_STAGES)[number];

export const FULFILLMENT_METHODS = ['counter', 'curbside', 'in_store', 'ship'] as const;
export type FulfillmentMethod = (typeof FULFILLMENT_METHODS)[number];

/**
 * Legal stage transitions. Any transition not listed here is rejected.
 * Method-specific branches (curbside vs ship) are enforced in canAdvance().
 */
export const LEGAL_TRANSITIONS: Record<OrderStage, OrderStage[]> = {
  placed:     ['paid', 'cancelled'],
  paid:       ['picking', 'cancelled'],
  picking:    ['packed', 'paid', 'cancelled'],          // 'paid' = batch released back to queue
  packed:     ['ready', 'cancelled'],                   // cancel after packed requires restock scan
  ready:      ['arrived', 'shipped', 'handed_off', 'cancelled'],
  arrived:    ['handed_off'],
  shipped:    ['completed'],
  handed_off: ['completed'],
  completed:  ['refunded'],
  cancelled:  [],
  refunded:   [],
};

export const TERMINAL_STAGES: OrderStage[] = ['completed', 'cancelled', 'refunded'];

/* ════════════════════════════════════════════════════════════════════════════
 * PRODUCTS & INVENTORY
 * ════════════════════════════════════════════════════════════════════════════ */

export interface RetailProduct {
  id: string;
  tenantId: string;
  name: string;
  sku: string;                 // unique per tenant
  barcode: string;             // UPC/EAN/Code-128 value printed on the item
  priceCents: number;
  compareAtCents?: number;     // optional strike-through price
  category: string;
  description?: string;
  imageUrls: string[];
  stockOnHand: number;         // physical units believed on shelf
  stockReserved: number;       // units held by paid, unfulfilled orders
  lowStockThreshold?: number;
  active: boolean;             // hidden from storefront when false
  allowBackorder: boolean;     // if true, availableStock may go negative at checkout
  createdAt: string;           // ISO strings everywhere; parse with safeDate()
  updatedAt: string;
}

/** Units a new order may sell right now. */
export function availableStock(p: Pick<RetailProduct, 'stockOnHand' | 'stockReserved'>): number {
  return p.stockOnHand - p.stockReserved;
}

export function isLowStock(p: RetailProduct): boolean {
  return availableStock(p) <= (p.lowStockThreshold ?? 0);
}

export const INVENTORY_MOVEMENT_TYPES = [
  'reserve',          // paid order holds stock            (reserved +qty)
  'release',          // cancellation frees a hold         (reserved -qty)
  'sale',             // handoff/ship converts the hold    (onHand -qty, reserved -qty)
  'short_adjustment', // picker found less on shelf        (onHand corrected down)
  'restock',          // receiving / cancelled-packed items scanned back (onHand +qty)
  'return_restock',   // sellable return scanned back      (onHand +qty)
  'write_off',        // damaged/defective, NOT sellable   (onHand -qty)
  'manual_adjustment',// count correction with reason      (onHand ±qty)
] as const;

export type InventoryMovementType = (typeof INVENTORY_MOVEMENT_TYPES)[number];

/** Append-only inventory ledger entry — the audit trail for stock. */
export interface InventoryMovement {
  id: string;
  tenantId: string;
  productId: string;
  sku: string;
  type: InventoryMovementType;
  qty: number;                 // always positive; direction implied by type
  onHandAfter: number;         // snapshot after the transaction applied
  reservedAfter: number;
  orderId?: string;
  returnId?: string;
  actorId: string;             // 'system' for webhook-driven moves
  actorName: string;
  reason?: string;             // required for manual_adjustment & write_off
  at: string;
}

/**
 * Given a movement type + qty, returns the deltas a Firestore transaction
 * must apply to the product doc. Keeps the math in exactly one place.
 */
export function movementDeltas(
  type: InventoryMovementType,
  qty: number
): { onHand: number; reserved: number } {
  switch (type) {
    case 'reserve':           return { onHand: 0,    reserved: qty };
    case 'release':           return { onHand: 0,    reserved: -qty };
    case 'sale':              return { onHand: -qty, reserved: -qty };
    case 'short_adjustment':  return { onHand: -qty, reserved: 0 };
    case 'restock':           return { onHand: qty,  reserved: 0 };
    case 'return_restock':    return { onHand: qty,  reserved: 0 };
    case 'write_off':         return { onHand: -qty, reserved: 0 };
    case 'manual_adjustment': return { onHand: qty,  reserved: 0 }; // pass negative qty to reduce
  }
}

/* ════════════════════════════════════════════════════════════════════════════
 * ORDER LINES
 * ════════════════════════════════════════════════════════════════════════════ */

export const LINE_STATUSES = [
  'pending',    // not yet picked
  'picked',     // qtyScanned === qtyOrdered
  'shorted',    // shelf discrepancy; qtyScanned < qtyOrdered, resolved below
  'refunded',   // shorted quantity refunded to customer
  'backordered',// shorted quantity split into a child order
  'returned',   // came back via RMA
] as const;

export type LineStatus = (typeof LINE_STATUSES)[number];

export interface OrderLine {
  lineId: string;              // stable per-line id (not array index)
  productId: string;
  sku: string;
  barcode: string;
  name: string;                // snapshot at purchase time
  unitPriceCents: number;      // snapshot at purchase time
  qtyOrdered: number;
  qtyScanned: number;
  qtyShorted: number;          // portion resolved as refunded/backordered
  qtyReturned: number;
  status: LineStatus;
  shortReason?: string;
}

export type ShortResolution = 'refund' | 'backorder';

