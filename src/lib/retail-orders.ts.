  tenantId: string;
  orderNumber: number;         // human-friendly sequential per tenant (e.g. 1042)
  stage: OrderStage;
  method: FulfillmentMethod;
  lines: OrderLine[];

  subtotalCents: number;
  taxCents: number;
  shippingCents: number;
