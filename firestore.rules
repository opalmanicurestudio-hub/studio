rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function tenantDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId));
    }
    function staffDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.auth.uid));
    }
    function hasStaffDoc(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.auth.uid));
    }
    // A team member signed in to the app with their own account: the server keeps staffDirectory/{uid} =
    // { tenantId, staffId, role } in step with their staff record (/api/staff/access). Nobody can write it from a browser.
    function dirEntry() {
      return get(/databases/$(database)/documents/staffDirectory/$(request.auth.uid));
    }
    function inDirectory(tenantId) {
      return exists(/databases/$(database)/documents/staffDirectory/$(request.auth.uid)) && dirEntry().data.tenantId == tenantId;
    }
    function isSelf(tenantId, staffId) {
      return isSignedIn() && (request.auth.uid == staffId || (inDirectory(tenantId) && dirEntry().data.staffId == staffId));
    }
    function isOwner(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantDoc(tenantId).data.userId ||
        (hasStaffDoc(tenantId) && staffDoc(tenantId).data.role == 'owner') ||
        (inDirectory(tenantId) && dirEntry().data.role == 'owner')
      );
    }
    function isStaff(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantDoc(tenantId).data.userId ||
        hasStaffDoc(tenantId) ||
        inDirectory(tenantId)
      );
    }
    // The team: the app's sign-ins, plus team members signed in to the staff portal with their PIN (not renters — they
    // run their own business and see only what's theirs).
    function isTeam(tenantId) {
      return isStaff(tenantId) || (isPortalMember(tenantId) && request.auth.token.get('isRenter', false) != true);
    }
    function portalStaffId() {
      return request.auth.token.get('staffId', '');
    }
    function staffStatusFields() {
      return ['status', 'onBreak', 'acceptingWalkIns', 'lastClockIn', 'lastClockOut', 'lastBreakStart', 'lastBreakEnd',
              'lastWalkInStartedAt', 'lastWalkInCompletedAt', 'turnOrder', 'currentAppointmentId', 'lastActiveAt', 'lastSeenAt', 'updatedAt'];
    }
    // What a team member may change on their OWN record — an allow-list, so a new pay or permission field is protected
    // the day it's added (the old block-list missed commission by service, per service pay and booking authority).
    function staffSelfFields() {
      return ['avatarUrl', 'photoURL', 'phone', 'phoneNumber', 'bio', 'specialties', 'pronouns', 'preferredName', 'emergencyContact',
              'address', 'notificationPrefs', 'notificationAvailability', 'quietHours', 'fcmTokens', 'language', 'updatedAt'];
    }
    // Pay rates live in staffPay (managers and the person only) — never on the staff record the team reads.
    function payKeys() {
      return ['commissionRate', 'retailCommissionRate', 'hourlyRate', 'serviceHourRate', 'servicePay', 'serviceCommission', 'nonServiceRate',
              'commissionTiers', 'salaryAmount', 'salaryPer', 'salaryWeekly', 'overtimeExempt', 'overtimeNonExempt'];
    }
    function isManager(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantDoc(tenantId).data.userId ||
        (hasStaffDoc(tenantId) && (
          staffDoc(tenantId).data.role == 'owner' ||
          staffDoc(tenantId).data.role == 'admin' ||
          staffDoc(tenantId).data.role == 'manager'
        )) ||
        (inDirectory(tenantId) && (dirEntry().data.role in ['owner', 'admin', 'manager'] || dirEntry().data.get('manager', false) == true))
      );
    }
    match /tenants/{tenantId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isOwner(tenantId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'userId', 'subscriptionStatus', 'subscriptionTier', 'accessLocked',
             'inviteCode', 'activatedAt', 'suspended', 'platformNotes', 'plan', 'billing'
           ]);
    }
    match /tenants/{tenantId}/services/{serviceId} {
      allow get, list: if true;
    }
    match /tenants/{tenantId}/staff/{staffId} {
      // Team only (phone, email live here; pay rates are in staffPay). Each person can read their own record; public pages use the
      // server's public cards (/api/public/staff: name, photo, title) instead.
      allow get: if isTeam(tenantId) || isSelf(tenantId, staffId) || (isPortalMember(tenantId) && portalStaffId() == staffId);
      allow list: if isTeam(tenantId);
      // Who can sign in is the server's job (authUid / appAccess), and only the business owner hands out the owner role.
      allow create: if isManager(tenantId) && !('authUid' in request.resource.data) && !('appAccess' in request.resource.data)
        && !request.resource.data.keys().hasAny(payKeys())
        && (!(request.resource.data.get('role', 'staff') in ['owner', 'admin']) || isOwner(tenantId));
      allow delete: if isManager(tenantId);
      allow update: if (isManager(tenantId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid', 'appAccess', 'appInvitedAt', 'appInvitedBy', 'appAccessOffAt'])
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(payKeys())
          && (request.resource.data.get('role', 'staff') == resource.data.get('role', 'staff') || !(request.resource.data.get('role', 'staff') in ['owner', 'admin']) || isOwner(tenantId))
          && (resource.data.get('role', 'staff') != 'owner' || request.auth.uid == tenantDoc(tenantId).data.userId || isOwner(tenantId)))
        || (isStaff(tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffStatusFields()))
        || (isStaff(tenantId) && isSelf(tenantId, staffId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffSelfFields()))
        || (isPortalMember(tenantId) && portalStaffId() == staffId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffSelfFields()))
        // A team member on their phone marks THEMSELVES busy / free (start a visit, finish, walk-ins on or off).
        || (isTeam(tenantId) && isPortalMember(tenantId) && portalStaffId() == staffId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffStatusFields()));
      match /private/{docId} {
        allow read, write: if false;
      }
    }
    // PAY RATES (lib/staff-pay): managers read and change them; each person reads their own.
    match /tenants/{tenantId}/staffPay/{staffId} {
      allow read: if isManager(tenantId) || isSelf(tenantId, staffId) || (isPortalMember(tenantId) && portalStaffId() == staffId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/consentForms/{formId} {
      allow get, list: if true;
    }
    match /tenants/{tenantId}/resources/{resourceId} {
      allow get, list: if true;
    }
    match /tenants/{tenantId}/inventory/{itemId} {
      allow get, list: if isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/appointments/{appointmentId} {
      allow read, create, delete: if isTeam(tenantId);
      allow update: if isTeam(tenantId)
        && request.resource.data.get('clinicCheckoff', null) == resource.data.get('clinicCheckoff', null)
        && !(request.resource.data.get('status', '') == 'completed'
             && resource.data.get('status', '') != 'completed'
             && request.resource.data.get('staffId', '') != ''
             && exists(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.resource.data.staffId))
             && get(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.resource.data.staffId)).data.get('isStudent', false) == true
             && resource.data.get('clinicCheckoff', {}).get('signedOff', false) != true);
    }
    match /tenants/{tenantId}/appointmentDecisions/{decisionId} {
      allow read: if isManager(tenantId);
      allow create: if isStaff(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/inventoryExceptions/{excId} {
      allow read, create: if isStaff(tenantId);
      allow update: if isManager(tenantId);
      allow delete: if false;
    }
    function staffCreditCapCents(tenantId) {
      return tenantDoc(tenantId).data
        .get('retailSettings', {})
        .get('staffCreditCapCents', 2500);
    }
    // STORE CREDIT. The team adds it by hand (a goodwill credit, a deposit): managers any amount, anyone else up to the
    // shop's limit. Credit for a return is issued only by the server (lib/return-credit), worked out from what was paid,
    // so nothing from a browser can be marked as one.
    match /tenants/{tenantId}/depositCredits/{creditId} {
      allow read: if isStaff(tenantId);
      allow create: if (isManager(tenantId) || (
          isStaff(tenantId)
          && request.resource.data.amountCents is int
          && request.resource.data.amountCents <= staffCreditCapCents(tenantId)
        ))
        && !request.resource.data.keys().hasAny(['sourceRetailReturnId', 'returnForOrderId']);
      allow update, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/serviceSessions/{sessionId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/parties/{partyId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/floorPlans/{planId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/clients/{clientId} {
      // New clients come from the team, the client portal, or the server (bookings, walk-ins, inquiries).
      allow create: if isTeam(tenantId) || (isPortalMember(tenantId) && request.auth.uid == clientId);
      allow read, write: if isTeam(tenantId);
      match /signedConsents/{consentId} {
        allow read, write: if isTeam(tenantId);
      }
    }
    match /tenants/{tenantId}/chargeConsents/{consentId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /clientScreens/{screenId} {
      allow read: if true;
      allow write: if false;
    }
    match /tenants/{tenantId}/approvals/{approvalId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/pendingCheckouts/{pendingId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    // Every shipping label bought, voided or replaced, with its refunds and carrier adjustments. The team reads them
    // (as they read the orders, the staff portal included); only the server writes them (api/retail/shipping-label,
    // the morning label check), so they're kept off the team catch-all below. Shippo invoices read for carrier
    // adjustments (shippoInvoices) are the server's own bookkeeping: no match here, so nobody reads or writes them.
    match /tenants/{tenantId}/shippingLabels/{labelId} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    // The USPS forms (api/retail/close-day) and the USPS pickups (api/retail/pickup, one booking a day): the server makes
    // and keeps them, so nobody can remove a day's booking or write one that was never made. The team reads them.
    match /tenants/{tenantId}/shipManifests/{manifestId} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/shipPickups/{day} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/staffSecrets/{staffId} { allow read, write: if false; }
    match /tenants/{tenantId}/approvalGuard/{docId} { allow read, write: if false; }
    match /tenants/{tenantId}/graceUses/{useId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/providerCallouts/{calloutId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    // The completion record holds the client's email and form ids: the team only. Clients reach it through
    // /api/visit-completion, which checks their link and returns a safe copy.
    match /tenants/{tenantId}/bookingCompletions/{token} {
      allow get: if isTeam(tenantId);
      allow list, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/completionSubmissions/{subId} {
      allow create: if false;
      allow read, update, delete: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/bookingRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isStaff(tenantId);
    }
    // Lounge and kiosk orders: the team only. Guests and the kiosk go through /api/guest-lounge and
    // /api/concierge/requests, which check the link or the menu and return only what the screen shows.
    match /tenants/{tenantId}/refreshmentRequests/{requestId} {
      allow read, create, update: if isTeam(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/notifications/{notificationId} {
      // The team and the portal can post; the public quote page can only post its own quote notices to the owner —
      // short, unaddressed, and of those four kinds.
      allow create: if isStaff(tenantId) || isPortalMember(tenantId)
        || (request.resource.data.get('type', '') in ['quote_viewed', 'quote_accepted', 'quote_declined', 'quote_revision']
            && !('userId' in request.resource.data)
            && request.resource.data.get('message', '') is string && request.resource.data.get('message', '').size() <= 400
            && request.resource.data.keys().hasOnly(['id', 'type', 'message', 'link', 'read', 'createdAt', 'quoteId', 'title', 'priority']));
      // The app's team sees the business's notices. A phone signed in with a PIN sees only its own — and, for managers,
      // the ones addressed to nobody in particular (floor alerts). Never anyone else's (PIN-reset codes go to managers).
      allow read, update, delete: if isStaff(tenantId) || (isPortalMember(tenantId) && (
        resource.data.get('userId', '') == portalStaffId()
        || (resource.data.get('userId', null) in [null, ''] && request.auth.token.get('role', '') in ['owner', 'admin', 'manager'])));
    }
    match /tenants/{tenantId}/assetUnits/{unitId} {
      allow read, write: if isStaff(tenantId);
    }
    // Kits (sets of tools): the team moves them along; only a manager adds or deletes one, puts a pulled-out kit
    // back into service, or retires it.
    match /tenants/{tenantId}/kits/{kitId} {
      allow read: if isStaff(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isStaff(tenantId) && (
        isManager(tenantId) ||
        (resource.data.status != 'out' && request.resource.data.status != 'retired'
          && request.resource.data.name == resource.data.name && request.resource.data.code == resource.data.code)
      );
    }
    // What's in each kit type and how long it takes to clean: managers decide; the team reads it.
    match /tenants/{tenantId}/kitTypes/{typeId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    // Tagged linen bundles: the team scans them along; only a manager makes or deletes one.
    match /tenants/{tenantId}/linenBundles/{bundleId} {
      allow read, update: if isStaff(tenantId);
      allow create, delete: if isManager(tenantId);
    }
    // Sterilisation records: the team writes them and records the result; nobody can delete one.
    match /tenants/{tenantId}/sterilisationCycles/{cycleId} {
      allow read, create: if isStaff(tenantId);
      allow update: if isStaff(tenantId) && resource.data.status == 'running';
      allow delete: if false;
    }
    // Linens: the team records washing and use; only a manager adds or deletes a type.
    match /tenants/{tenantId}/linens/{linenId} {
      allow read, update: if isStaff(tenantId);
      allow create, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/assetScanEvents/{eventId} {
      allow read, create: if isStaff(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/stationAllocations/{allocationId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/staffReplenishmentRequests/{requestId} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) && request.resource.data.staffId == request.auth.uid;
      allow update: if isManager(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/overflowEvents/{eventId} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId);
      allow update: if isManager(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/plaidItems/{itemId} {
      allow read, write: if false;
    }
    match /tenants/{tenantId}/private/{docId} {
      allow read, write: if false;
    }
    match /tenants/{tenantId}/bankTransactions/{txnId} {
      allow read: if isOwner(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/vendorRules/{ruleId} {
      allow read: if isOwner(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/auditLogs/{entryId} {
      allow create: if isTeam(tenantId);
      allow read: if isManager(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/signedDocuments/{docId} {
      allow create: if isStaff(tenantId);
      allow read: if isManager(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/transactions/{txnId} {
      // A portal sign-in reads only its own sales (their earnings).
      allow read: if isStaff(tenantId) || (isPortalMember(tenantId) && resource.data.get('staffId', '') == portalStaffId());
      allow create, update: if isStaff(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/rentInvoices/{invId} {
      allow read: if isStaff(tenantId);
      allow update: if isManager(tenantId);
      allow create, delete: if false;
    }
    // PAY STUBS (saved on payday), PAY QUESTIONS ("something's off") and the CORRECTIONS that settle them: each person
    // reads their own, managers read everyone's; only the server writes them (/api/pay/*).
    match /tenants/{tenantId}/payStubs/{stubId} {
      allow read: if isManager(tenantId) || isSelf(tenantId, resource.data.staffId) || (isPortalMember(tenantId) && resource.data.staffId == portalStaffId());
      allow write: if false;
    }
    match /tenants/{tenantId}/payQuestions/{qId} {
      allow read: if isManager(tenantId) || isSelf(tenantId, resource.data.staffId) || (isPortalMember(tenantId) && resource.data.staffId == portalStaffId());
      allow write: if false;
    }
    match /tenants/{tenantId}/payAdjustments/{adjId} {
      allow read: if isManager(tenantId) || isSelf(tenantId, resource.data.staffId) || (isPortalMember(tenantId) && resource.data.staffId == portalStaffId());
      allow write: if false;
    }
    // MAKING IT RIGHT — complaint cases. The desk and managers read them all; a provider reads cases about their own
    // visits, and the provider doing a client's fix reads that case, from the portal. Only the server writes (/api/cases), so every step is on the case's record.
    match /tenants/{tenantId}/cases/{caseId} {
      allow read: if isStaff(tenantId) || (isPortalMember(tenantId) && (resource.data.get('visit', {}).get('providerId', '') == portalStaffId()
        || portalStaffId() in resource.data.get('involvedStaffIds', [])));
      allow write: if false;
    }
    // CLIENT CONDUCT reports from providers: managers only, never the client; only the server writes them.
    match /tenants/{tenantId}/conductReports/{reportId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/counters/{counterId} {
      allow read, write: if false;
    }
    // A renter's own Making it right settings: read and saved through the server only (/api/cases).
    match /tenants/{tenantId}/renterSettings/{staffId} {
      allow read, write: if false;
    }
    // REFUNDS ON CASH SALES (pickup envelopes, app refunds): the front desk and managers read them; only the server
    // writes (/api/refund-payouts). Pickup codes are server-only, so a staff device can never read one.
    match /tenants/{tenantId}/refundPayouts/{payoutId} {
      allow read: if isManager(tenantId) || (hasStaffDoc(tenantId) && staffDoc(tenantId).data.get('role', '') == 'front_desk')
        || (inDirectory(tenantId) && dirEntry().data.get('role', '') == 'front_desk')
        // the staff app on a phone (Me → Refunds to give): front desk and managers signed in with their PIN
        || (isPortalMember(tenantId) && request.auth.token.get('role', '') in ['owner', 'admin', 'manager', 'front_desk']);
      allow write: if false;
    }
    match /tenants/{tenantId}/refundCodes/{payoutId} {
      allow read, write: if false;
    }
    // GIFT CARDS (lib/gift-cards): codes are money, so only the front desk and managers read them; only the server writes.
    match /tenants/{tenantId}/giftCards/{cardId} {
      allow read: if isManager(tenantId) || (hasStaffDoc(tenantId) && staffDoc(tenantId).data.get('role', '') == 'front_desk')
        || (inDirectory(tenantId) && dirEntry().data.get('role', '') == 'front_desk');
      allow write: if false;
    }
    // GIFT CARDS BOUGHT ONLINE (lib/gift-shop): the buyer's order — managers can look; only the server writes.
    match /tenants/{tenantId}/giftOrders/{orderId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    // CHIP-IN GIFTS (lib/gift-groups) and COMPANY ORDERS (lib/gift-bulk): managers can look; only the server writes.
    match /tenants/{tenantId}/giftGroups/{groupId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/giftBulk/{bulkId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    // PAST SALES TOTALS from another app (Moving in → lib/import-more saveSales): managers can look; only the server writes.
    match /tenants/{tenantId}/salesHistory/{monthId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    // IMPORTS from another app (/api/import): managers see the history; only the server writes.
    match /tenants/{tenantId}/imports/{importId} {
      allow read: if isManager(tenantId);
      allow write: if false;
      match /fills/{fillId} {
        allow read, write: if false;
      }
    }
    // LOW REVIEWS from Google (lib/review-watch): the front desk and managers read them; only the server writes.
    match /tenants/{tenantId}/externalReviews/{reviewId} {
      allow read: if isManager(tenantId) || (hasStaffDoc(tenantId) && staffDoc(tenantId).data.get('role', '') == 'front_desk')
        || (inDirectory(tenantId) && dirEntry().data.get('role', '') == 'front_desk');
      allow write: if false;
    }
    // Finished payroll runs (from the payroll connection): managers only — never readable from a staff phone.
    match /tenants/{tenantId}/payrollRuns/{runId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/payrollDrafts/{draftId} {
      allow read, update: if isManager(tenantId);
      allow create, delete: if false;
    }
    match /tenants/{tenantId}/lifestyleProfiles/{pId} {
      allow read, write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/businessProfiles/{pId} {
      allow read, write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/billDefinitions/{defId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/billInstances/{instId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/booths/{boothId} {
      allow get, list: if true;
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/boothApplications/{appId} {
      allow create: if true;
      allow read, update: if isStaff(tenantId);
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/boothReservations/{resId} {
      allow read, update: if isStaff(tenantId);
      allow create: if false;
      allow delete: if false;
    }
    match /tenants/{tenantId}/tours/{tourId} {
      allow create: if true;
      allow read, update: if isStaff(tenantId);
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/boothCredits/{creditId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/renters/{renterId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/leases/{leaseId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/boothPasses/{passId} {
      allow read: if isStaff(tenantId);
      allow create: if isManager(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/boothPassPurchases/{purchaseId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/contacts/{contactId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/tickets/{ticketId} {
      allow read, create, update: if isStaff(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/maintenanceWorkers/{workerId} {
      allow read, write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/maintenancePlans/{planId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/serviceProviders/{providerId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/appointmentCheckIns/{token} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/locations/{locationId} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) && request.resource.data.get('locationTypeId', '') != '';
      allow delete: if isStaff(tenantId) && resource.data.get('locationTypeId', '') != '';
      allow update: if isStaff(tenantId)
        && (request.resource.data.get('locationTypeId', '') == '') == (resource.data.get('locationTypeId', '') == '');
    }
    // TIME CLOCK PUNCHES: recorded only by the server (/api/timeclock/punch, from every clock screen). The team can read
    // them; a staff-portal sign-in reads only its own. Only managers may correct them (Timesheets) — nobody can edit or
    // approve their own punches.
    match /tenants/{tenantId}/activityLogs/{logId} {
      allow read: if isStaff(tenantId)
        || (isPortalMember(tenantId) && resource.data.staffId == request.auth.token.staffId);
      allow create, update, delete: if isManager(tenantId);
    }
    // SHIFTS: the team reads and plans them as before. A staff-portal sign-in (not a renter) reads the team's schedule
    // so swaps and cover can be offered; changes go through the server (/api/shifts/request).
    match /tenants/{tenantId}/shifts/{shiftId} {
      allow read: if isStaff(tenantId)
        || (isPortalMember(tenantId) && request.auth.token.isRenter != true);
      allow write: if isStaff(tenantId);
    }
    // SHIFT REQUESTS: written by the server (portal) or the team (app). A portal sign-in reads its own, the swaps asked
    // of it, and — for managers — everyone's.
    match /tenants/{tenantId}/shiftRequests/{requestId} {
      allow read: if isStaff(tenantId)
        || (isPortalMember(tenantId) && (resource.data.staffId == request.auth.token.staffId
             || resource.data.get('swapWithStaffId', '') == request.auth.token.staffId
             || request.auth.token.role in ['owner', 'admin', 'manager']));
      allow write: if isStaff(tenantId);
    }
    // TEAM CHAT: everyone in the app's team; a portal sign-in (staff or renter) only the conversations they're in, and
    // only posts as themselves.
    match /tenants/{tenantId}/staffThreads/{threadId} {
      allow read: if isStaff(tenantId) || (isPortalMember(tenantId) && portalStaffId() in resource.data.get('participantIds', []));
      allow create, update: if isStaff(tenantId) || (isPortalMember(tenantId) && portalStaffId() in request.resource.data.get('participantIds', []));
      allow delete: if isManager(tenantId);
      match /messages/{messageId} {
        allow read, update: if isStaff(tenantId) || (isPortalMember(tenantId)
          && portalStaffId() in get(/databases/$(database)/documents/tenants/$(tenantId)/staffThreads/$(threadId)).data.get('participantIds', []));
        allow create: if isStaff(tenantId) || (isPortalMember(tenantId)
          && request.resource.data.get('senderId', '') == portalStaffId()
          && portalStaffId() in get(/databases/$(database)/documents/tenants/$(tenantId)/staffThreads/$(threadId)).data.get('participantIds', []));
        allow delete: if isStaff(tenantId);
      }
    }
    // THE CONVERSATION RECORD (lib/conversation) — the team can read it; only the server writes it, so nothing said
    // to or by a client can be edited or deleted. The receptionist's inbox items can be updated (status) but never deleted.
    match /tenants/{tenantId}/messageLog/{id} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/smsInbox/{id} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/smsThreads/{threadId}/{rest=**} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/smsThreads/{threadId} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/voiceCalls/{id} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/clientNotes/{id} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/voiceInbox/{id} {
      allow read, create, update: if isTeam(tenantId);
      allow delete: if false;
    }
    // Identity checks: codes sent to clients and the phones they've confirmed. Server only.
    match /tenants/{tenantId}/clientVerifications/{id} {
      allow read, write: if false;
    }
    match /tenants/{tenantId}/clientDevices/{id} {
      allow read, write: if false;
    }
    // Who opened a client's health information. Written by the server; managers may read it.
    match /tenants/{tenantId}/healthViewLog/{id} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    // THE LOYALTY LEDGER (lib/loyalty-server): every earn, redeem, reversal and adjustment. The team can read it; only the
    // server writes it, so nobody can give points from a browser.
    match /tenants/{tenantId}/loyaltyLedger/{id} {
      allow read: if isTeam(tenantId);
      allow write: if false;
    }
    // SHOP ORDERS. The team runs fulfilment from the browser (claim, scan, pack, shelf, hand over, ship, short, return), so
    // the team can update orders, but never the money, identity or verification fields: what was charged and refunded,
    // the order total, the customer's email and pickup code, the payment ids, the risk check and holds set by the
    // payment step, swap questions (all written by the server), and which order a backorder or replacement was made from.
    // Shorts, cancels and returns change the refund owed from the browser; the money itself only moves on the server,
    // where it's capped at what the card paid and the person's refund limit. Only managers release a hold or mark a refund
    // as done by hand. New orders from the browser are the zero-value follow-ups the engine makes (a backorder, a
    // replacement, a split); paid orders are only ever created by checkout on the server.
    function orderLockedKeys() {
      return ['chargedCents', 'totalCents', 'subtotalCents', 'taxCents', 'shippingCents', 'tipCents', 'qrToken', 'customerEmail', 'clientId',
              'orderNumber', 'stripePaymentIntentId', 'stripeCheckoutSessionId', 'refundInFlight', 'refundSeq', 'lastStripeRefundId',
              'riskCheck', 'holdAuto', 'idCheck', 'swapOffer', 'swapPendingPhone', 'giftSpentAt', 'giftCardCents', 'giftCardId',
              'storeCreditRequestedCents', 'creditShortfallCents', 'nonCardRestoredAt', 'nonCardRestored', 'isTest', 'policySnapshot',
              'refundedOtherCents', 'parentOrderId'];
    }
    // What a new order from the browser may never carry: those follow-ups have no payment of their own, so nothing about
    // a payment, a gift card or store credit, or a refund already made can be set on one. Only checkout on the server
    // creates an order that was paid.
    function orderCreateLockedKeys() {
      return ['chargedCents', 'tipCents', 'clientId', 'stripePaymentIntentId', 'stripeCheckoutSessionId', 'refundInFlight', 'refundSeq',
              'lastStripeRefundId', 'riskCheck', 'holdAuto', 'idCheck', 'swapOffer', 'swapPendingPhone', 'giftSpentAt', 'giftCardCents',
              'giftCardId', 'giftCardCode', 'storeCreditRequestedCents', 'creditShortfallCents', 'creditAppliedCents', 'nonCardRestoredAt',
              'nonCardRestored', 'refundedOtherCents', 'paidVia', 'isTest', 'policySnapshot'];
    }
    match /tenants/{tenantId}/retailOrders/{orderId} {
      allow read: if isTeam(tenantId);
      allow create: if isTeam(tenantId)
        && !request.resource.data.keys().hasAny(orderCreateLockedKeys())
        && request.resource.data.get('totalCents', 0) == 0
        && request.resource.data.get('subtotalCents', 0) == 0
        && request.resource.data.get('taxCents', 0) == 0
        && request.resource.data.get('shippingCents', 0) == 0
        && request.resource.data.get('pendingRefundCents', 0) == 0
        && request.resource.data.get('refundedCents', 0) == 0;
      allow update: if isTeam(tenantId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(orderLockedKeys())
        && (isManager(tenantId) || (
              request.resource.data.get('refundedCents', 0) == resource.data.get('refundedCents', 0)
              && (request.resource.data.get('holdForReview', false) == true || resource.data.get('holdForReview', false) != true)
           ));
      allow delete: if false;
      // The order's history: added to, never rewritten.
      match /events/{eventId} {
        allow read, create: if isTeam(tenantId);
        allow update, delete: if false;
      }
    }
    // RENT LEDGER. Managers record rent payments and credits; online-shop sale credits for renters are written only by
    // the server (lib/renter-sales-server), so nobody can add one from a browser.
    match /tenants/{tenantId}/rentLedger/{entryId} {
      allow read: if isTeam(tenantId);
      allow create, update: if isManager(tenantId)
        && request.resource.data.get('type', '') != 'retail_sale_credit'
        && (resource == null || resource.data.get('type', '') != 'retail_sale_credit');
      allow delete: if isManager(tenantId) && resource.data.get('type', '') != 'retail_sale_credit';
    }
    match /tenants/{tenantId}/{collection}/{rest=**} {
      allow read, write: if isTeam(tenantId) &&
        !(collection in [
          'courses', 'enrollments', 'students', 'studentSessions', 'studentLogins',
          'learningSessions', 'attendance', 'academyAudit', 'academyAuditMeta',
          'programs', 'programEnrollments', 'clinicCheckoffs',
          'graceUses', 'providerCallouts',
          'approvals', 'staffSecrets', 'approvalGuard', 'pendingCheckouts',
          'chargeConsents',
          'admissions', 'cohorts', 'tuitionPlans', 'tuitionEntries',
          'academyThreads', 'academyAnnouncements', 'tutorLogs', 'tutorUsage', 'liveSessions', 'liveAttendance', 'rotations', 'translations', 'tuitionPayments', 'studentFiles', 'boardForms', 'questionBank', 'submissions', 'approvedDevices', 'materials', 'aiUsage', 'interactives', 'practiceAttempts', 'assigned', 'studentGroups', 'schoolDocs', 'docAcks', 'studentLetters', 'presentations', 'studyNotes', 'studyState', 'portfolio', 'schoolIdentity', 'schoolSite', 'websiteMessages', 'donations', 'scholarshipApplications', 'sponsors',
          'depositCredits', 'loyaltyLedger', 'retailOrders', 'rentLedger',
          'shippingLabels', 'shippoInvoices', 'shipManifests', 'shipPickups',
          'inventoryExceptions',
          'activityLogs', 'shifts', 'shiftRequests', 'staffThreads',
          'kits', 'linens', 'kitTypes', 'linenBundles', 'sterilisationCycles',
          'assetUnits',
          'assetScanEvents',
          'stationAllocations',
          'staffReplenishmentRequests',
          'overflowEvents',
          'plaidItems',
          'private',
          'staff',
          'bankTransactions',
          'vendorRules',
          'auditLogs',
          'signedDocuments',
          'transactions',
          'rentInvoices',
          'payrollDrafts',
          'payrollRuns',
          'payStubs', 'payQuestions', 'payAdjustments', 'staffPay', 'cases', 'counters', 'renterSettings', 'conductReports', 'refundPayouts', 'refundCodes', 'externalReviews', 'imports', 'giftCards', 'giftOrders', 'giftGroups', 'giftBulk', 'salesHistory', 'documents', 'inspectorLinks', 'certifications', 'renterDocs', 'oneOnOnes', 'opportunities', 'opportunityTexts', 'results', 'heldTexts', 'renterInbox', 'referrals', 'creatorCampaigns', 'tasks', 'notifications', 'openings', 'tidyAsks',
          'lifestyleProfiles',
          'businessProfiles',
          'billDefinitions',
          'billInstances',
          'boothApplications',
          'boothReservations',
          'tours',
          'boothCredits',
          'renters',
          'leases',
          'appointmentCheckIns',
          'boothPasses',
          'boothPassPurchases',
          'tickets',
          'maintenanceWorkers',
          'maintenancePlans',
          'locations',
          'messageLog', 'smsInbox', 'smsThreads', 'voiceCalls', 'clientNotes', 'voiceInbox',
          'clientVerifications', 'clientDevices', 'healthViewLog'
        ]);
    }
    match /tenants/{tenantId}/jobListings/{listingId} {
      allow get, list: if true;
      allow create, update, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/applications/{applicationId} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.experience.size() <= 2000
        && request.resource.data.message.size() <= 2000
        && (!('answers' in request.resource.data) || request.resource.data.answers.size() <= 8)
        && request.resource.data.createdAt == request.time;
      allow read, list, update, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/applications/{applicationId}/messages/{messageId} {
      allow read, list, create, update, delete: if isManager(tenantId);
    }
    function isPortalMember(tenantId) {
      return isSignedIn()
        && request.auth.token.portal == true
        && request.auth.token.tenantId == tenantId;
    }
    // Who may write documents: managers, plus any role the business lets manage documents (Settings → Roles).
    function canManageDocs(tenantId) {
      return isManager(tenantId) || (inDirectory(tenantId) && 'documents.manage' in dirEntry().data.get('caps', []));
    }
    // A renter signed in to the staff app reads only documents sent to renters, or to them by name (building rules) —
    // never the team's handbook and SOPs. Their own documents live in renterDocs (server only).
    function renterMayRead(tenantId, d) {
      return isPortalMember(tenantId) && ('renter' in d.get('assignedRoles', []) || portalStaffId() in d.get('assignedStaffIds', []));
    }
    match /tenants/{tenantId}/documents/{documentId} {
      allow get, list: if isTeam(tenantId) || renterMayRead(tenantId, resource.data);
      allow create, update, delete: if canManageDocs(tenantId);
    }
    // INSPECTOR LINKS (lib/training-proof): made, listed and turned off through the server only.
    match /tenants/{tenantId}/inspectorLinks/{linkId} {
      allow read, write: if false;
    }
    // CERTIFIED FOR A SERVICE (lib/certification): read and written through the server only (/api/certifications).
    match /tenants/{tenantId}/certifications/{certId} {
      allow read, write: if false;
    }
    // A RENTER'S OWN DOCUMENTS (lib/renter-docs): their SOPs and aftercare — private to the renter; read and written
    // through the server only (/api/portal/renter-docs), so the studio's app can't read them.
    match /tenants/{tenantId}/renterDocs/{docId} {
      allow read, write: if false;
    }
    // ONE-ON-ONES (lib/staff-kpis-server): between a manager and one team member — read and written through the server
    // only (/api/team/kpis), so the rest of the team can't read them.
    match /tenants/{tenantId}/oneOnOnes/{id} {
      allow read, write: if false;
    }
    // Each published version, kept as it was (with its "what changed" note).
    match /tenants/{tenantId}/documents/{documentId}/versions/{versionId} {
      allow get, list: if isTeam(tenantId) || renterMayRead(tenantId, get(/databases/$(database)/documents/tenants/$(tenantId)/documents/$(documentId)).data);
      allow create, update: if canManageDocs(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/documents/{documentId}/acks/{ackId} {
      // The team sees who has signed; a renter sees only their own sign-off.
      allow get, list: if isTeam(tenantId) || (isPortalMember(tenantId) && ackId == portalStaffId());
      // A sign-off is your own (or a manager recording one for someone).
      allow create, update: if (
          isManager(tenantId)
          || (isStaff(tenantId) && (ackId == request.auth.uid || (inDirectory(tenantId) && dirEntry().data.staffId == ackId)))
          || (isPortalMember(tenantId) && ackId == request.auth.token.staffId)
        )
        && request.resource.data.version is number
        && request.resource.data.staffName is string
        && request.resource.data.staffName.size() <= 140;
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/documents/{documentId}/runs/{runId} {
      allow get, list: if isTeam(tenantId) || (isPortalMember(tenantId) && resource.data.get('staffId', '') == portalStaffId());
      allow create, update: if (
          isStaff(tenantId)
          || (isPortalMember(tenantId) && request.resource.data.staffId == request.auth.token.staffId)
        )
        && request.resource.data.checkedCount is number
        && request.resource.data.totalItems is number
        && request.resource.data.staffName is string
        && request.resource.data.staffName.size() <= 140;
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/renters/{renterId}/private/{docId} {
      allow read, write: if false;
    }
    match /tenants/{tenantId}/renterServices/{serviceId} {
      allow read: if true;
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/tasks/{taskId} {
      // Explicit only (tasks is off the team catch-all): anyone can complete their own, managers and document managers run the list.
      allow get, list: if isStaff(tenantId) || isPortalMember(tenantId);
      allow create, delete: if canManageDocs(tenantId);
      allow update: if canManageDocs(tenantId)
        || (isPortalMember(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'completedBy', 'completedByName', 'completedAt', 'photoUrl', 'photoUrls'])
            && request.resource.data.completedBy == request.auth.token.staffId)
        || (isStaff(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'completedBy', 'completedByName', 'completedAt', 'photoUrl', 'photoUrls']));
    }
    match /tenants/{tenantId}/rotations/{rotationId} {
      allow get, list: if isStaff(tenantId) || isPortalMember(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isManager(tenantId)
        || (isPortalMember(tenantId)
            && request.auth.token.staffId in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['currentIndex', 'history', 'lastDoneDate', 'memberIds']));
    }
    match /tenants/{tenantId}/interviewInvites/{inviteId} {
      allow get: if true;
      allow list: if isManager(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isManager(tenantId)
        || (resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chosenSlot', 'respondedAt', 'proposedSlots', 'applicantNote'])
            && (request.resource.data.status == 'accepted'
                || request.resource.data.status == 'needs_new_times'
                || request.resource.data.status == 'countered')
            && (!('proposedSlots' in request.resource.data) || request.resource.data.proposedSlots.size() <= 5)
            && (!('applicantNote' in request.resource.data)
                || (request.resource.data.applicantNote is string && request.resource.data.applicantNote.size() <= 500)));
    }
    match /tenants/{tenantId}/tourInvites/{inviteId} {
      allow get: if true;
      allow list: if isManager(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isManager(tenantId)
        || (resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chosenSlot', 'respondedAt', 'proposedSlots', 'prospectNote'])
            && (request.resource.data.status == 'accepted'
                || request.resource.data.status == 'needs_new_times'
                || request.resource.data.status == 'countered')
            && (!('proposedSlots' in request.resource.data) || request.resource.data.proposedSlots.size() <= 5)
            && (!('prospectNote' in request.resource.data)
                || (request.resource.data.prospectNote is string && request.resource.data.prospectNote.size() <= 500)));
    }
    function isRealUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function teamOf(t) {
      return t is string && t != '' && (isStaff(t) || isPortalMember(t));
    }
    // The visit link's copy. Clients see their visit through the server (/api/visit-view, whitelisted fields only),
    // so the copy is no longer readable by anyone holding a token — only by the business's own team.
    match /appointmentCheckIns/{token} {
      allow get: if isSignedIn() && teamOf(resource.data.get('tenantId', ''));
      allow list: if isSignedIn() && (isStaff(resource.data.tenantId) || isPortalMember(resource.data.tenantId));
      allow create: if teamOf(request.resource.data.get('tenantId', ''));
      allow update: if teamOf(resource.data.get('tenantId', ''));
      allow delete: if false;
    }
    // Practice a shift, two players: a desk device and a client-screen device share one short-lived room.
    // Practice data only (made-up clients, no real customer details). The 6-character code is the key.
    match /practiceRooms/{roomId} {
      function roomShape(d) {
        return d.keys().hasOnly(['host', 'v', 'desk', 'client', 'createdAt', 'expiresAt'])
          && d.host is string && d.desk is map && d.desk.size() <= 16
          && (!('lines' in d.desk) || (d.desk.lines is list && d.desk.lines.size() <= 40))
          && (!('choices' in d.desk) || (d.desk.choices is list && d.desk.choices.size() <= 12))
          && (d.client == null || (d.client is map && d.client.size() <= 4));
      }
      allow get: if isSignedIn() && resource.data.expiresAt > request.time;
      allow list: if false;
      allow create: if isSignedIn() && roomId.matches('^[A-HJ-NP-Z2-9]{6}$')
        && roomShape(request.resource.data)
        && request.resource.data.host == request.auth.uid
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.expiresAt < request.time + duration.value(13, 'h');
      allow update: if isSignedIn() && resource.data.expiresAt > request.time
        && roomShape(request.resource.data)
        && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['client'])
            || (request.auth.uid == resource.data.host
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['desk', 'client'])));
      allow delete: if isSignedIn() && request.auth.uid == resource.data.host;
    }
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /staffDirectory/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, write: if false;
    }
  }
}
