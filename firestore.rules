rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function tenantDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId));
    }
    function staffDoc(tenantId) {
      return get(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.auth.uid));
    }
    function hasStaffDoc(tenantId) {
      return exists(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.auth.uid));
    }
    // A team member signed in to the app with their own account: the server keeps staffDirectory/{uid} =
    // { tenantId, staffId, role } in step with their staff record (/api/staff/access). Nobody can write it from a browser.
    function dirEntry() {
      return get(/databases/$(database)/documents/staffDirectory/$(request.auth.uid));
    }
    function inDirectory(tenantId) {
      return exists(/databases/$(database)/documents/staffDirectory/$(request.auth.uid)) && dirEntry().data.tenantId == tenantId;
    }
    function isSelf(tenantId, staffId) {
      return isSignedIn() && (request.auth.uid == staffId || (inDirectory(tenantId) && dirEntry().data.staffId == staffId));
    }
    function isOwner(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantDoc(tenantId).data.userId ||
        (hasStaffDoc(tenantId) && staffDoc(tenantId).data.role == 'owner') ||
        (inDirectory(tenantId) && dirEntry().data.role == 'owner')
      );
    }
    function isStaff(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantDoc(tenantId).data.userId ||
        hasStaffDoc(tenantId) ||
        inDirectory(tenantId)
      );
    }
    // The team: the app's sign-ins, plus team members signed in to the staff portal with their PIN (not renters — they
    // run their own business and see only what's theirs).
    function isTeam(tenantId) {
      return isStaff(tenantId) || (isPortalMember(tenantId) && request.auth.token.get('isRenter', false) != true);
    }
    function portalStaffId() {
      return request.auth.token.get('staffId', '');
    }
    function staffStatusFields() {
      return ['status', 'onBreak', 'acceptingWalkIns', 'lastClockIn', 'lastClockOut', 'lastBreakStart', 'lastBreakEnd',
              'lastWalkInStartedAt', 'lastWalkInCompletedAt', 'turnOrder', 'currentAppointmentId', 'lastActiveAt', 'lastSeenAt', 'updatedAt'];
    }
    // What a team member may change on their OWN record — an allow-list, so a new pay or permission field is protected
    // the day it's added (the old block-list missed commission by service, per service pay and booking authority).
    function staffSelfFields() {
      return ['avatarUrl', 'photoURL', 'phone', 'phoneNumber', 'bio', 'specialties', 'pronouns', 'preferredName', 'emergencyContact',
              'address', 'notificationPrefs', 'notificationAvailability', 'quietHours', 'fcmTokens', 'language', 'updatedAt'];
    }
    function isManager(tenantId) {
      return isSignedIn() && (
        request.auth.uid == tenantDoc(tenantId).data.userId ||
        (hasStaffDoc(tenantId) && (
          staffDoc(tenantId).data.role == 'owner' ||
          staffDoc(tenantId).data.role == 'admin' ||
          staffDoc(tenantId).data.role == 'manager'
        )) ||
        (inDirectory(tenantId) && (dirEntry().data.role in ['owner', 'admin', 'manager'] || dirEntry().data.get('manager', false) == true))
      );
    }
    match /tenants/{tenantId} {
      allow get: if true;
      allow list: if false;
      allow create: if false;
      allow update: if isOwner(tenantId)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'userId', 'subscriptionStatus', 'subscriptionTier', 'accessLocked',
             'inviteCode', 'activatedAt', 'suspended', 'platformNotes', 'plan', 'billing'
           ]);
    }
    match /tenants/{tenantId}/services/{serviceId} {
      allow get, list: if true;
    }
    match /tenants/{tenantId}/staff/{staffId} {
      // Team only (pay rates, phone, email live here). Each person can read their own record; public pages use the
      // server's public cards (/api/public/staff: name, photo, title) instead.
      allow get: if isTeam(tenantId) || isSelf(tenantId, staffId) || (isPortalMember(tenantId) && portalStaffId() == staffId);
      allow list: if isTeam(tenantId);
      // Who can sign in is the server's job (authUid / appAccess), and only the business owner hands out the owner role.
      allow create: if isManager(tenantId) && !('authUid' in request.resource.data) && !('appAccess' in request.resource.data)
        && (!(request.resource.data.get('role', 'staff') in ['owner', 'admin']) || isOwner(tenantId));
      allow delete: if isManager(tenantId);
      allow update: if (isManager(tenantId)
          && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['authUid', 'appAccess', 'appInvitedAt', 'appInvitedBy', 'appAccessOffAt'])
          && (request.resource.data.get('role', 'staff') == resource.data.get('role', 'staff') || !(request.resource.data.get('role', 'staff') in ['owner', 'admin']) || isOwner(tenantId))
          && (resource.data.get('role', 'staff') != 'owner' || request.auth.uid == tenantDoc(tenantId).data.userId || isOwner(tenantId)))
        || (isStaff(tenantId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffStatusFields()))
        || (isStaff(tenantId) && isSelf(tenantId, staffId) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffSelfFields()))
        || (isPortalMember(tenantId) && portalStaffId() == staffId && request.resource.data.diff(resource.data).affectedKeys().hasOnly(staffSelfFields()));
      match /private/{docId} {
        allow read, write: if false;
      }
    }
    match /tenants/{tenantId}/consentForms/{formId} {
      allow get, list: if true;
    }
    match /tenants/{tenantId}/resources/{resourceId} {
      allow get, list: if true;
    }
    match /tenants/{tenantId}/inventory/{itemId} {
      allow get, list: if isStaff(tenantId);
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/appointments/{appointmentId} {
      allow read, create, delete: if isTeam(tenantId);
      allow update: if isTeam(tenantId)
        && request.resource.data.get('clinicCheckoff', null) == resource.data.get('clinicCheckoff', null)
        && !(request.resource.data.get('status', '') == 'completed'
             && resource.data.get('status', '') != 'completed'
             && request.resource.data.get('staffId', '') != ''
             && exists(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.resource.data.staffId))
             && get(/databases/$(database)/documents/tenants/$(tenantId)/staff/$(request.resource.data.staffId)).data.get('isStudent', false) == true
             && resource.data.get('clinicCheckoff', {}).get('signedOff', false) != true);
    }
    match /tenants/{tenantId}/appointmentDecisions/{decisionId} {
      allow read: if isManager(tenantId);
      allow create: if isStaff(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/inventoryExceptions/{excId} {
      allow read, create: if isStaff(tenantId);
      allow update: if isManager(tenantId);
      allow delete: if false;
    }
    function staffCreditCapCents(tenantId) {
      return tenantDoc(tenantId).data
        .get('retailSettings', {})
        .get('staffCreditCapCents', 2500);
    }
    match /tenants/{tenantId}/depositCredits/{creditId} {
      allow read: if isStaff(tenantId);
      allow create: if isManager(tenantId) || (
        isStaff(tenantId) && (
          ('sourceRetailReturnId' in request.resource.data) ||
          (request.resource.data.amountCents is int
            && request.resource.data.amountCents <= staffCreditCapCents(tenantId))
        )
      );
      allow update, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/serviceSessions/{sessionId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/parties/{partyId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/floorPlans/{planId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/clients/{clientId} {
      // New clients come from the team, the client portal, or the server (bookings, walk-ins, inquiries).
      allow create: if isTeam(tenantId) || (isPortalMember(tenantId) && request.auth.uid == clientId);
      allow read, write: if isTeam(tenantId);
      match /signedConsents/{consentId} {
        allow read, write: if isTeam(tenantId);
      }
    }
    match /tenants/{tenantId}/chargeConsents/{consentId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /clientScreens/{screenId} {
      allow read: if true;
      allow write: if false;
    }
    match /tenants/{tenantId}/approvals/{approvalId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/pendingCheckouts/{pendingId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/staffSecrets/{staffId} { allow read, write: if false; }
    match /tenants/{tenantId}/approvalGuard/{docId} { allow read, write: if false; }
    match /tenants/{tenantId}/graceUses/{useId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/providerCallouts/{calloutId} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/bookingCompletions/{token} {
      allow get: if true;
      allow list, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/completionSubmissions/{subId} {
      allow create: if false;
      allow read, update, delete: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/bookingRequests/{requestId} {
      allow create: if true;
      allow read, update, delete: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/refreshmentRequests/{requestId} {
      allow read, create: if true;
      allow update: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/notifications/{notificationId} {
      // The team and the portal can post; the public quote page can only post its own quote notices to the owner —
      // short, unaddressed, and of those four kinds.
      allow create: if isStaff(tenantId) || isPortalMember(tenantId)
        || (request.resource.data.get('type', '') in ['quote_viewed', 'quote_accepted', 'quote_declined', 'quote_revision']
            && !('userId' in request.resource.data)
            && request.resource.data.get('message', '') is string && request.resource.data.get('message', '').size() <= 400
            && request.resource.data.keys().hasOnly(['id', 'type', 'message', 'link', 'read', 'createdAt', 'quoteId', 'title', 'priority']));
      allow read, update, delete: if isStaff(tenantId) || isPortalMember(tenantId);
    }
    match /tenants/{tenantId}/assetUnits/{unitId} {
      allow read, write: if isStaff(tenantId);
    }
    // Kits (sets of tools): the team moves them along; only a manager adds or deletes one, puts a pulled-out kit
    // back into service, or retires it.
    match /tenants/{tenantId}/kits/{kitId} {
      allow read: if isStaff(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isStaff(tenantId) && (
        isManager(tenantId) ||
        (resource.data.status != 'out' && request.resource.data.status != 'retired'
          && request.resource.data.name == resource.data.name && request.resource.data.code == resource.data.code)
      );
    }
    // What's in each kit type and how long it takes to clean: managers decide; the team reads it.
    match /tenants/{tenantId}/kitTypes/{typeId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    // Tagged linen bundles: the team scans them along; only a manager makes or deletes one.
    match /tenants/{tenantId}/linenBundles/{bundleId} {
      allow read, update: if isStaff(tenantId);
      allow create, delete: if isManager(tenantId);
    }
    // Sterilisation records: the team writes them and records the result; nobody can delete one.
    match /tenants/{tenantId}/sterilisationCycles/{cycleId} {
      allow read, create: if isStaff(tenantId);
      allow update: if isStaff(tenantId) && resource.data.status == 'running';
      allow delete: if false;
    }
    // Linens: the team records washing and use; only a manager adds or deletes a type.
    match /tenants/{tenantId}/linens/{linenId} {
      allow read, update: if isStaff(tenantId);
      allow create, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/assetScanEvents/{eventId} {
      allow read, create: if isStaff(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/stationAllocations/{allocationId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/staffReplenishmentRequests/{requestId} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) && request.resource.data.staffId == request.auth.uid;
      allow update: if isManager(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/overflowEvents/{eventId} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId);
      allow update: if isManager(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/plaidItems/{itemId} {
      allow read, write: if false;
    }
    match /tenants/{tenantId}/private/{docId} {
      allow read, write: if false;
    }
    match /tenants/{tenantId}/bankTransactions/{txnId} {
      allow read: if isOwner(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/vendorRules/{ruleId} {
      allow read: if isOwner(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/auditLogs/{entryId} {
      allow create: if isStaff(tenantId);
      allow read: if isManager(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/signedDocuments/{docId} {
      allow create: if isStaff(tenantId);
      allow read: if isManager(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/transactions/{txnId} {
      // A portal sign-in reads only its own sales (their earnings).
      allow read: if isStaff(tenantId) || (isPortalMember(tenantId) && resource.data.get('staffId', '') == portalStaffId());
      allow create, update: if isStaff(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/rentInvoices/{invId} {
      allow read: if isStaff(tenantId);
      allow update: if isManager(tenantId);
      allow create, delete: if false;
    }
    match /tenants/{tenantId}/payrollDrafts/{draftId} {
      allow read, update: if isManager(tenantId);
      allow create, delete: if false;
    }
    match /tenants/{tenantId}/lifestyleProfiles/{pId} {
      allow read, write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/businessProfiles/{pId} {
      allow read, write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/billDefinitions/{defId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/billInstances/{instId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/booths/{boothId} {
      allow get, list: if true;
      allow write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/boothApplications/{appId} {
      allow create: if true;
      allow read, update: if isStaff(tenantId);
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/boothReservations/{resId} {
      allow read, update: if isStaff(tenantId);
      allow create: if false;
      allow delete: if false;
    }
    match /tenants/{tenantId}/tours/{tourId} {
      allow create: if true;
      allow read, update: if isStaff(tenantId);
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/boothCredits/{creditId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/renters/{renterId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/leases/{leaseId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/boothPasses/{passId} {
      allow read: if isStaff(tenantId);
      allow create: if isManager(tenantId);
      allow update, delete: if false;
    }
    match /tenants/{tenantId}/boothPassPurchases/{purchaseId} {
      allow read: if isManager(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/contacts/{contactId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/tickets/{ticketId} {
      allow read, create, update: if isStaff(tenantId);
      allow delete: if false;
    }
    match /tenants/{tenantId}/maintenanceWorkers/{workerId} {
      allow read, write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/maintenancePlans/{planId} {
      allow read: if isStaff(tenantId);
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/serviceProviders/{providerId} {
      allow read, write: if isStaff(tenantId);
    }
    match /tenants/{tenantId}/appointmentCheckIns/{token} {
      allow read: if isStaff(tenantId);
      allow write: if false;
    }
    match /tenants/{tenantId}/locations/{locationId} {
      allow read: if isStaff(tenantId);
      allow create: if isStaff(tenantId) && request.resource.data.get('locationTypeId', '') != '';
      allow delete: if isStaff(tenantId) && resource.data.get('locationTypeId', '') != '';
      allow update: if isStaff(tenantId)
        && (request.resource.data.get('locationTypeId', '') == '') == (resource.data.get('locationTypeId', '') == '');
    }
    // TIME CLOCK PUNCHES: recorded only by the server (/api/timeclock/punch, from every clock screen). The team can read
    // them; a staff-portal sign-in reads only its own. Only managers may correct them (Timesheets) — nobody can edit or
    // approve their own punches.
    match /tenants/{tenantId}/activityLogs/{logId} {
      allow read: if isStaff(tenantId)
        || (isPortalMember(tenantId) && resource.data.staffId == request.auth.token.staffId);
      allow create, update, delete: if isManager(tenantId);
    }
    // SHIFTS: the team reads and plans them as before. A staff-portal sign-in (not a renter) reads the team's schedule
    // so swaps and cover can be offered; changes go through the server (/api/shifts/request).
    match /tenants/{tenantId}/shifts/{shiftId} {
      allow read: if isStaff(tenantId)
        || (isPortalMember(tenantId) && request.auth.token.isRenter != true);
      allow write: if isStaff(tenantId);
    }
    // SHIFT REQUESTS: written by the server (portal) or the team (app). A portal sign-in reads its own, the swaps asked
    // of it, and — for managers — everyone's.
    match /tenants/{tenantId}/shiftRequests/{requestId} {
      allow read: if isStaff(tenantId)
        || (isPortalMember(tenantId) && (resource.data.staffId == request.auth.token.staffId
             || resource.data.get('swapWithStaffId', '') == request.auth.token.staffId
             || request.auth.token.role in ['owner', 'admin', 'manager']));
      allow write: if isStaff(tenantId);
    }
    // TEAM CHAT: everyone in the app's team; a portal sign-in (staff or renter) only the conversations they're in, and
    // only posts as themselves.
    match /tenants/{tenantId}/staffThreads/{threadId} {
      allow read: if isStaff(tenantId) || (isPortalMember(tenantId) && portalStaffId() in resource.data.get('participantIds', []));
      allow create, update: if isStaff(tenantId) || (isPortalMember(tenantId) && portalStaffId() in request.resource.data.get('participantIds', []));
      allow delete: if isManager(tenantId);
      match /messages/{messageId} {
        allow read, update: if isStaff(tenantId) || (isPortalMember(tenantId)
          && portalStaffId() in get(/databases/$(database)/documents/tenants/$(tenantId)/staffThreads/$(threadId)).data.get('participantIds', []));
        allow create: if isStaff(tenantId) || (isPortalMember(tenantId)
          && request.resource.data.get('senderId', '') == portalStaffId()
          && portalStaffId() in get(/databases/$(database)/documents/tenants/$(tenantId)/staffThreads/$(threadId)).data.get('participantIds', []));
        allow delete: if isStaff(tenantId);
      }
    }
    match /tenants/{tenantId}/{collection}/{rest=**} {
      allow read, write: if isTeam(tenantId) &&
        !(collection in [
          'courses', 'enrollments', 'students', 'studentSessions', 'studentLogins',
          'learningSessions', 'attendance', 'academyAudit', 'academyAuditMeta',
          'programs', 'programEnrollments', 'clinicCheckoffs',
          'graceUses', 'providerCallouts',
          'approvals', 'staffSecrets', 'approvalGuard', 'pendingCheckouts',
          'chargeConsents',
          'admissions', 'cohorts', 'tuitionPlans', 'tuitionEntries',
          'academyThreads', 'academyAnnouncements', 'tutorLogs', 'tutorUsage', 'liveSessions', 'liveAttendance', 'rotations', 'translations', 'tuitionPayments', 'studentFiles', 'boardForms', 'questionBank', 'submissions', 'approvedDevices', 'materials', 'aiUsage', 'interactives', 'practiceAttempts', 'assigned', 'studentGroups', 'schoolDocs', 'docAcks', 'studentLetters', 'presentations', 'studyNotes', 'studyState', 'portfolio', 'schoolIdentity', 'schoolSite', 'websiteMessages', 'donations', 'scholarshipApplications', 'sponsors',
          'depositCredits',
          'inventoryExceptions',
          'activityLogs', 'shifts', 'shiftRequests', 'staffThreads',
          'kits', 'linens', 'kitTypes', 'linenBundles', 'sterilisationCycles',
          'assetUnits',
          'assetScanEvents',
          'stationAllocations',
          'staffReplenishmentRequests',
          'overflowEvents',
          'plaidItems',
          'private',
          'staff',
          'bankTransactions',
          'vendorRules',
          'auditLogs',
          'signedDocuments',
          'transactions',
          'rentInvoices',
          'payrollDrafts',
          'lifestyleProfiles',
          'businessProfiles',
          'billDefinitions',
          'billInstances',
          'boothApplications',
          'boothReservations',
          'tours',
          'boothCredits',
          'renters',
          'leases',
          'appointmentCheckIns',
          'boothPasses',
          'boothPassPurchases',
          'tickets',
          'maintenanceWorkers',
          'maintenancePlans',
          'locations'
        ]);
    }
    match /tenants/{tenantId}/jobListings/{listingId} {
      allow get, list: if true;
      allow create, update, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/applications/{applicationId} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.experience.size() <= 2000
        && request.resource.data.message.size() <= 2000
        && (!('answers' in request.resource.data) || request.resource.data.answers.size() <= 8)
        && request.resource.data.createdAt == request.time;
      allow read, list, update, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/applications/{applicationId}/messages/{messageId} {
      allow read, list, create, update, delete: if isManager(tenantId);
    }
    function isPortalMember(tenantId) {
      return isSignedIn()
        && request.auth.token.portal == true
        && request.auth.token.tenantId == tenantId;
    }
    match /tenants/{tenantId}/documents/{documentId} {
      allow get, list: if isStaff(tenantId) || isPortalMember(tenantId);
      allow create, update, delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/documents/{documentId}/acks/{ackId} {
      allow get, list: if isStaff(tenantId) || isPortalMember(tenantId);
      allow create, update: if (
          isStaff(tenantId)
          || (isPortalMember(tenantId) && ackId == request.auth.token.staffId)
        )
        && request.resource.data.version is number
        && request.resource.data.staffName is string
        && request.resource.data.staffName.size() <= 140;
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/documents/{documentId}/runs/{runId} {
      allow get, list: if isStaff(tenantId) || isPortalMember(tenantId);
      allow create, update: if (
          isStaff(tenantId)
          || (isPortalMember(tenantId) && request.resource.data.staffId == request.auth.token.staffId)
        )
        && request.resource.data.checkedCount is number
        && request.resource.data.totalItems is number
        && request.resource.data.staffName is string
        && request.resource.data.staffName.size() <= 140;
      allow delete: if isManager(tenantId);
    }
    match /tenants/{tenantId}/renters/{renterId}/private/{docId} {
      allow read, write: if false;
    }
    match /tenants/{tenantId}/renterServices/{serviceId} {
      allow read: if true;
      allow write: if isManager(tenantId);
    }
    match /tenants/{tenantId}/tasks/{taskId} {
      allow get, list: if isStaff(tenantId) || isPortalMember(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isManager(tenantId)
        || (isPortalMember(tenantId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'completedBy', 'completedByName', 'completedAt', 'photoUrl', 'photoUrls'])
            && request.resource.data.completedBy == request.auth.token.staffId);
    }
    match /tenants/{tenantId}/rotations/{rotationId} {
      allow get, list: if isStaff(tenantId) || isPortalMember(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isManager(tenantId)
        || (isPortalMember(tenantId)
            && request.auth.token.staffId in resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['currentIndex', 'history', 'lastDoneDate', 'memberIds']));
    }
    match /tenants/{tenantId}/interviewInvites/{inviteId} {
      allow get: if true;
      allow list: if isManager(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isManager(tenantId)
        || (resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chosenSlot', 'respondedAt', 'proposedSlots', 'applicantNote'])
            && (request.resource.data.status == 'accepted'
                || request.resource.data.status == 'needs_new_times'
                || request.resource.data.status == 'countered')
            && (!('proposedSlots' in request.resource.data) || request.resource.data.proposedSlots.size() <= 5)
            && (!('applicantNote' in request.resource.data)
                || (request.resource.data.applicantNote is string && request.resource.data.applicantNote.size() <= 500)));
    }
    match /tenants/{tenantId}/tourInvites/{inviteId} {
      allow get: if true;
      allow list: if isManager(tenantId);
      allow create, delete: if isManager(tenantId);
      allow update: if isManager(tenantId)
        || (resource.data.status == 'pending'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'chosenSlot', 'respondedAt', 'proposedSlots', 'prospectNote'])
            && (request.resource.data.status == 'accepted'
                || request.resource.data.status == 'needs_new_times'
                || request.resource.data.status == 'countered')
            && (!('proposedSlots' in request.resource.data) || request.resource.data.proposedSlots.size() <= 5)
            && (!('prospectNote' in request.resource.data)
                || (request.resource.data.prospectNote is string && request.resource.data.prospectNote.size() <= 500)));
    }
    function isRealUser() {
      return isSignedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }
    function teamOf(t) {
      return t is string && t != '' && (isStaff(t) || isPortalMember(t));
    }
    match /appointmentCheckIns/{token} {
      allow get: if true;
      allow list: if isSignedIn() && (isStaff(resource.data.tenantId) || isPortalMember(resource.data.tenantId));
      allow create: if teamOf(request.resource.data.get('tenantId', ''));
      allow update: if teamOf(resource.data.get('tenantId', ''));
      allow delete: if false;
    }
    match /users/{userId} {
      allow read, write: if isSignedIn() && request.auth.uid == userId;
    }
    match /staffDirectory/{userId} {
      allow get: if isSignedIn() && request.auth.uid == userId;
      allow list, write: if false;
    }
  }
}
